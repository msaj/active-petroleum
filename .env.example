# Public site address used for canonical links and the sitemap
NEXT_PUBLIC_SITE_URL=https://active-petroleum.vercel.app

# Supabase (already used by /admin)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: lets the daily cron write the price archive. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Random long string; Vercel sends it to /api/cron/fuel
CRON_SECRET=
